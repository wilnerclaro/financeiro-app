# Endereço do app, sem https:// (ex.: financeiro-familia.duckdns.org)
DOMINIO=

POSTGRES_DB=financeiro_db
POSTGRES_USER=financeiro_user
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Gere com: openssl rand -base64 48
JWT_SECRET=

# Client ID OAuth do Google (tipo Web). Vazio esconde o botão "Entrar com Google".
GOOGLE_CLIENT_ID=

# Hora do backup diário (0 a 23, horário de Brasília) e quantos dias guardar
BACKUP_HORA=3
BACKUP_DIAS=14
